{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "PostgreSQL",
  "SeedExcelOnStartup": false,
  "TLogSettings": {
    "ResponseSize": 4096,
    "ExcludeClasses": [],
    "ExcludeMethods": [],
    "ExcludeAssemblies": [
      "Microsoft",
      "System"
    ],
    "SensitiveProps": [
      "password",
      "token",
      "secret",
      "authorization"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/qlstudy-dev-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Jwt": {
    "SecretKey": "QLStudy_Dev_Secret_Key_For_Local_Development_1234567890"
  },
  "ConnectionStrings": {
    "SqliteConnection": "Data Source=qlstudy-dev.db",
    "PostgresConnection": "Host=localhost;Port=5432;Database=qlstudy_dev;Username=postgres;Password=postgres;Include Error Detail=true"
  }
}
